# Copy this file to .env and fill in values from https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret

# Must exactly match an "Authorized redirect URL" in your LinkedIn app's Auth tab
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# Any long random string; used to sign the session cookie
SESSION_SECRET=change_me_to_a_long_random_string

PORT=3000
