# Postgres (docker compose up -d db)
DATABASE_URL="postgresql://windsliter:windsliter@localhost:5432/windsliter"

# Auth.js — generate with: npx auth secret   (or any 32+ char random string)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# LinkedIn OIDC (optional locally; the LinkedIn button is hidden when unset)
# Redirect URL to register in your LinkedIn app: http://localhost:3000/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# --- Email delivery for magic links: fill in ONE option. With neither, links are only
# printed to the server console and written to .dev-mail/last-link.txt ---

# Option A: SMTP, e.g. Gmail. Turn on 2-Step Verification for the Google account, then create
# an App Password at https://myaccount.google.com/apppasswords (16 letters, not your normal password).
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Option B: Resend (https://resend.com). Until you verify a domain there, Resend only
# delivers to your own Resend account address.
RESEND_API_KEY=""

# Sender name/address shown in the email (optional; SMTP defaults to EMAIL_SERVER_USER)
EMAIL_FROM=""
